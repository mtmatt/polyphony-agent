# Polyphony Agent Configuration Example

# Global settings
auto_commit = false
budget_limit = 5.0

# Individual settings for planner and executor
[planner]
provider = "gemini"
model = "gemini-2.5-pro-exp"
flash_model = "gemini-2.5-flash-exp"

[executor]
provider = "openai"
model = "gpt-4o"
flash_model = "gpt-4o-mini"
base_url = "http://localhost:11434/v1" # Example for Ollama
api_key = "ollama"

# Fallback: Flat structure (sets both planner and executor to same values)
# provider = "gemini"
# model = "gemini-2.5-flash-exp"

# Claude CLI example (requires `claude` CLI installed and authenticated)
# [planner]
# provider = "claude"
# model = "claude-opus-4-5"
#
# [executor]
# provider = "claude"
# model = "claude-sonnet-4-5"
# flash_model = "claude-haiku-3-5"
